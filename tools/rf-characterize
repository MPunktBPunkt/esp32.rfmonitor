#!/usr/bin/env python3
"""Score Characterization A–G.

Modes:
  sim     — synthetic feature changes (no device); validates assessment sensitivity
  session — analyze a session export with phase markers

Exit 0 if all checked experiments move in the expected direction.
"""

from __future__ import annotations

import argparse
import json
import sys
from dataclasses import dataclass
from pathlib import Path
from typing import Any, Dict, List, Optional, Tuple

sys.path.insert(0, str(Path(__file__).resolve().parent))
from rf_score import Features, compute_v1, compute_v2, features_from_session_sample  # noqa: E402


@dataclass
class Experiment:
    id: str
    note: str
    mutate: Any  # (Features) -> Features
    expect_feature: str  # breakdown key that should increase (penalty) or special
    expect_score_down: bool
    # For F/G: score should go up / recover vs baseline


def base_lab() -> Features:
    return Features(
        own_rssi=-48,
        rssi_jitter=2,
        density_proxy=12,
        pressure_proxy=10,
        occupancy_proxy=24,
        stability=100,
        connected=True,
        measurement_quality=100,
    )


EXPERIMENTS: List[Experiment] = [
    Experiment(
        "A",
        "RSSI −20 dB",
        lambda f: Features(**{**f.__dict__, "own_rssi": f.own_rssi - 20}),
        "own_link",
        True,
    ),
    Experiment(
        "B",
        "+5 APs → density",
        lambda f: Features(**{**f.__dict__, "density_proxy": min(80, f.density_proxy + 20)}),
        "density",
        True,
    ),
    Experiment(
        "C",
        "same-channel pressure",
        lambda f: Features(**{**f.__dict__, "pressure_proxy": min(80, f.pressure_proxy + 40)}),
        "pressure",
        True,
    ),
    Experiment(
        "D",
        "more occupied channels",
        lambda f: Features(**{**f.__dict__, "occupancy_proxy": min(100, f.occupancy_proxy + 40)}),
        "occupancy",
        True,
    ),
    Experiment(
        "E",
        "WLAN disconnect",
        lambda f: Features(**{**f.__dict__, "connected": False}),
        "disconnect",
        True,
    ),
    Experiment(
        "F",
        "stabilize jitter",
        lambda f: Features(**{**f.__dict__, "rssi_jitter": 0, "own_rssi": -48}),
        "jitter",
        False,  # score should not drop; vs high-jitter baseline we compare separately
    ),
    Experiment(
        "G",
        "return to baseline",
        lambda f: base_lab(),
        "none",
        False,
    ),
]


def part_value(parts, key: str) -> int:
    return int(getattr(parts, key, 0) or 0)


def run_sim(verbose: bool = True) -> int:
    base = base_lab()
    b1, b2 = compute_v1(base), compute_v2(base)
    # F needs a jittery reference
    jittery = Features(**{**base.__dict__, "rssi_jitter": 20})
    j2 = compute_v2(jittery)

    failed = 0
    rows = []
    for ex in EXPERIMENTS:
        feat = ex.mutate(base)
        r1, r2 = compute_v1(feat), compute_v2(feat)
        ok = True
        detail = ""

        if ex.id == "F":
            # vs jittery: score up, jitter penalty down
            ok = r2.score > j2.score and r2.parts.jitter < j2.parts.jitter
            detail = f"vs jittery {j2.score}->{r2.score} jitter {j2.parts.jitter}->{r2.parts.jitter}"
        elif ex.id == "G":
            ok = abs(r2.score - b2.score) <= 1
            detail = f"score {r2.score} vs base {b2.score}"
        elif ex.id == "D":
            # occupancy only in v2
            ok = r2.parts.occupancy > b2.parts.occupancy and r2.score < b2.score
            detail = f"occ {b2.parts.occupancy}->{r2.parts.occupancy} score {b2.score}->{r2.score}"
        else:
            pen_b = part_value(b2.parts, ex.expect_feature)
            pen_r = part_value(r2.parts, ex.expect_feature)
            ok = pen_r > pen_b and r2.score < b2.score
            detail = f"{ex.expect_feature} {pen_b}->{pen_r} score {b2.score}->{r2.score}"

        if not ok:
            failed += 1
        rows.append((ex.id, ex.note, r1.score, r2.score, ok, detail))

    if verbose:
        print("# Score Characterization SIM (pure RfScore)")
        print(f"# baseline v1={b1.score} v2={b2.score}")
        print(f"{'ID':<3} {'note':<28} {'v1':>4} {'v2':>4} {'ok':>3}  detail")
        for r in rows:
            print(f"{r[0]:<3} {r[1]:<28} {r[2]:4d} {r[3]:4d} {'Y' if r[4] else 'N':>3}  {r[5]}")
        print(f"# result: {'PASS' if failed == 0 else 'FAIL'} ({failed} failed)")
    return 0 if failed == 0 else 1


def _phase_samples(samples: List[Dict[str, Any]], phase_id: str) -> List[Dict[str, Any]]:
    return [s for s in samples if (s.get("phase") or "") == phase_id]


def _avg_feat(samples: List[Dict[str, Any]]) -> Optional[Features]:
    if not samples:
        return None
    feats = [features_from_session_sample(s) for s in samples]
    n = float(len(feats))
    return Features(
        own_rssi=int(round(sum(f.own_rssi for f in feats) / n)),
        rssi_jitter=sum(f.rssi_jitter for f in feats) / n,
        density_proxy=int(round(sum(f.density_proxy for f in feats) / n)),
        pressure_proxy=int(round(sum(f.pressure_proxy for f in feats) / n)),
        occupancy_proxy=int(round(sum(f.occupancy_proxy for f in feats) / n)),
        stability=int(round(sum(f.stability for f in feats) / n)),
        connected=sum(1 for f in feats if f.connected) >= n / 2,
        measurement_quality=int(round(sum(f.measurement_quality for f in feats) / n)),
    )


def run_session(path: Path, verbose: bool = True) -> int:
    data = json.loads(path.read_text(encoding="utf-8"))
    samples = data.get("samples") or []
    phases = data.get("phases") or []
    if verbose:
        print(f"# session={path.name} profile={data.get('profile')} phases={len(phases)} samples={len(samples)}")

    # Prefer phase field on samples; fall back to phase index ranges.
    by_phase: Dict[str, List[Dict[str, Any]]] = {}
    for s in samples:
        pid = s.get("phase") or ""
        if pid:
            by_phase.setdefault(pid, []).append(s)
    if not by_phase and phases:
        # Reconstruct from start/end sample indices against chronological ring order.
        # sampleCount may exceed ring — use ring order as approx.
        for ph in phases:
            pid = ph.get("id") or ""
            start = int(ph.get("startSample") or 0)
            end = int(ph.get("endSample") or len(samples))
            # Map absolute sample indices onto ring window if possible — best effort:
            # take all samples already tagged, else slice ring proportionally.
            by_phase[pid] = samples  # weak fallback; operator should use markPhase

    if not by_phase:
        print("# no phase markers in session — run SIM instead or mark phases on device", file=sys.stderr)
        return 2

    # Baseline = phase G if present else unlabeled early samples / phase-less
    base_samples = by_phase.get("G") or []
    if not base_samples:
        base_samples = [s for s in samples if not s.get("phase")][: max(3, len(samples) // 10)]
    base_feat = _avg_feat(base_samples) or base_lab()
    b2 = compute_v2(base_feat)

    failed = 0
    for ex in EXPERIMENTS:
        if ex.id not in by_phase:
            if verbose:
                print(f"{ex.id}  SKIP (no samples)")
            continue
        feat = _avg_feat(by_phase[ex.id])
        if not feat:
            continue
        r2 = compute_v2(feat)
        device_scores = [int(s.get("score") or 0) for s in by_phase[ex.id]]
        avg_dev = sum(device_scores) / len(device_scores)

        if ex.id in ("F", "G"):
            ok = r2.score >= b2.score - 2
        else:
            ok = r2.score < b2.score
        if not ok:
            failed += 1
        if verbose:
            print(
                f"{ex.id}  replay_v2={r2.score} base={b2.score} device_avg={avg_dev:.1f} "
                f"n={len(by_phase[ex.id])} {'OK' if ok else 'FAIL'}  ({ex.note})"
            )
    if verbose:
        print(f"# result: {'PASS' if failed == 0 else 'FAIL'} ({failed} failed)")
    return 0 if failed == 0 else 1


def main() -> int:
    ap = argparse.ArgumentParser(description="RF Score Characterization A–G")
    ap.add_argument("mode", choices=("sim", "session"), help="sim | session")
    ap.add_argument("session", nargs="?", type=Path, help="session JSON for session mode")
    ap.add_argument("-q", "--quiet", action="store_true")
    args = ap.parse_args()
    if args.mode == "sim":
        return run_sim(verbose=not args.quiet)
    if not args.session:
        print("session mode needs a session JSON path", file=sys.stderr)
        return 2
    return run_session(args.session, verbose=not args.quiet)


if __name__ == "__main__":
    raise SystemExit(main())
